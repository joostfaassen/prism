{% extends 'admin/integrations_base.html.twig' %}

{% block title %}Integrations{% endblock %}

{% block integrations_main %}
            <div class="mb-8 flex flex-col lg:flex-row lg:items-end lg:justify-between gap-6">
                <div>
                    <h1 class="text-3xl font-bold text-white mb-2">Integrations</h1>
                    <p class="text-slate-400 max-w-2xl">
                        Capability packs available to MCP servers.
                        {{ activeCount }} active with accounts &middot; {{ unusedCount }} unused &middot; {{ totalCount }} registered
                    </p>
                </div>
            </div>

            {% if unregisteredTypes is not empty %}
            <div class="mb-8 rounded-2xl border border-amber-800 bg-amber-950/40 px-6 py-5">
                <h2 class="text-sm font-semibold text-amber-300 mb-2">Unregistered account types</h2>
                <p class="text-sm text-amber-200/80 mb-3">Present in config or tools but missing an <code class="font-mono text-xs">*Integration</code> class.</p>
                <div class="flex flex-wrap gap-2">
                    {% for type in unregisteredTypes %}
                    <span class="font-mono text-xs font-semibold text-amber-200 bg-amber-900/50 px-3 py-1.5 rounded-lg">{{ type }}</span>
                    {% endfor %}
                </div>
            </div>
            {% endif %}

            {% if integrations is not empty %}
            <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3 mb-12">
                {% for item in integrations %}
                <a href="{{ path('admin_integration_detail', {type: item.type}) }}"
                   class="group relative bg-slate-900 border rounded-2xl p-6 transition-all duration-300 block
                          {% if item.active %}border-slate-800 hover:border-emerald-800/70{% else %}border-slate-800/70 hover:border-slate-700 opacity-80 hover:opacity-100{% endif %}">
                    <div class="flex items-start justify-between gap-3 mb-3">
                        <div class="min-w-0">
                            <h2 class="text-lg font-bold text-white group-hover:text-cyan-300 transition-colors truncate">{{ item.label }}</h2>
                            <span class="font-mono text-xs text-slate-500">{{ item.type }}</span>
                        </div>
                        {% if item.active %}
                        <span class="shrink-0 inline-flex items-center gap-1.5 text-[11px] font-mono font-semibold text-emerald-300 bg-emerald-950/80 border border-emerald-900/60 px-2.5 py-1 rounded-lg">
                            <span class="w-1.5 h-1.5 bg-emerald-400 rounded-full"></span>
                            active
                        </span>
                        {% else %}
                        <span class="shrink-0 text-[11px] font-mono text-slate-500 bg-slate-800/80 px-2.5 py-1 rounded-lg">unused</span>
                        {% endif %}
                    </div>

                    <p class="text-sm text-slate-400 mb-5 line-clamp-2 min-h-[2.5rem]">{{ item.description }}</p>

                    <div class="flex flex-wrap gap-x-4 gap-y-1 text-xs font-mono text-slate-500 mb-4">
                        <span>{{ item.toolCount }} tool{{ item.toolCount != 1 ? 's' : '' }}</span>
                        {% if item.active %}
                        <span class="text-emerald-400/90">{{ item.accountCount }} account{{ item.accountCount != 1 ? 's' : '' }}</span>
                        <span>{{ item.serverCount }} server{{ item.serverCount != 1 ? 's' : '' }}</span>
                        {% else %}
                        <span>no accounts</span>
                        {% endif %}
                    </div>

                    {% if item.servers is not empty %}
                    <div class="pt-4 border-t border-slate-800/80 flex flex-wrap gap-1.5">
                        {% for server in item.servers|slice(0, 4) %}
                        <span class="text-[11px] font-mono text-slate-300 bg-slate-800 px-2 py-1 rounded-md" title="{{ server.label }}">{{ server.name }}{% if server.accountCount > 1 %} ×{{ server.accountCount }}{% endif %}</span>
                        {% endfor %}
                        {% if item.servers|length > 4 %}
                        <span class="text-[11px] font-mono text-slate-500 px-1 py-1">+{{ item.servers|length - 4 }}</span>
                        {% endif %}
                    </div>
                    {% else %}
                    <div class="pt-4 border-t border-slate-800/80 text-xs text-slate-600">
                        Not wired to any MCP server yet
                    </div>
                    {% endif %}
                </a>
                {% endfor %}
            </div>
            {% else %}
            <div class="mb-12 rounded-2xl border border-slate-800 bg-slate-900 px-6 py-10 text-center text-slate-400 text-sm">
                {% if filter == 'active' %}
                    No integrations have accounts configured. Add accounts under a
                    <a href="{{ path('admin_dashboard') }}" class="text-cyan-400 hover:text-cyan-300">server</a>.
                {% elseif filter == 'unused' %}
                    Every registered integration has at least one account.
                {% else %}
                    No integrations registered.
                {% endif %}
            </div>
            {% endif %}

            <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6">
                <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-2 mb-5">
                    <div>
                        <h2 class="text-lg font-bold text-white">Utility tools</h2>
                        <p class="text-sm text-slate-400">Always available on every server (no account type)</p>
                    </div>
                    <span class="text-xs font-mono text-slate-500">{{ utilityTools|length }} tools</span>
                </div>
                {% if utilityTools is not empty %}
                <ul class="divide-y divide-slate-800">
                    {% for tool in utilityTools %}
                    <li class="py-3 flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-4">
                        <code class="text-sm font-mono text-cyan-300 shrink-0">{{ tool.name }}</code>
                        <span class="text-sm text-slate-400">{{ tool.description }}</span>
                    </li>
                    {% endfor %}
                </ul>
                {% else %}
                <p class="text-sm text-slate-500">No utility tools registered.</p>
                {% endif %}
            </div>
{% endblock %}
