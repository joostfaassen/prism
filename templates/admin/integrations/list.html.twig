{% extends 'base.html.twig' %}

{% block title %}Integrations{% endblock %}

{% block body %}
<div class="min-h-full relative">
    <div class="absolute inset-0 bg-gradient-to-br from-cyan-950 via-slate-950 to-blue-950"></div>
    <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 50%, rgba(6, 182, 212, 0.4) 0%, transparent 40%), radial-gradient(circle at 80% 20%, rgba(59, 130, 246, 0.3) 0%, transparent 40%), radial-gradient(circle at 50% 80%, rgba(139, 92, 246, 0.2) 0%, transparent 40%);"></div>

    <div class="relative z-10">
        <nav class="border-b border-slate-800 bg-slate-900 bg-opacity-40">
            <div class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <a href="{{ path('admin_dashboard') }}" class="flex items-center gap-3 group">
                        <div class="w-9 h-9 rounded-lg bg-gradient-to-br from-cyan-400 to-blue-500 flex items-center justify-center shadow-lg">
                            <svg class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M13.19 8.688a4.5 4.5 0 0 1 1.242 7.244l-4.5 4.5a4.5 4.5 0 0 1-6.364-6.364l1.757-1.757m13.35-.622 1.757-1.757a4.5 4.5 0 0 0-6.364-6.364l-4.5 4.5a4.5 4.5 0 0 0 1.242 7.244" />
                            </svg>
                        </div>
                        <span class="text-lg font-bold bg-gradient-to-r from-cyan-300 to-blue-400 bg-clip-text text-transparent group-hover:from-cyan-200 group-hover:to-blue-300 transition-colors">Prism</span>
                    </a>
                    <span class="text-xs font-mono text-slate-500 hidden sm:inline bg-slate-800 px-2.5 py-1 rounded-full">Integrations</span>
                </div>
                <div class="flex items-center gap-4">
                    <a href="{{ path('admin_dashboard') }}" class="text-sm text-slate-400 hover:text-cyan-300 transition-colors font-medium">Back to dashboard</a>
                    <a href="{{ path('app_logout') }}" class="text-sm text-slate-400 hover:text-cyan-300 transition-colors font-medium">Sign Out</a>
                </div>
            </div>
        </nav>

        <div class="max-w-7xl mx-auto px-6 py-10">
            <div class="mb-10">
                <h1 class="text-3xl font-bold text-white mb-2">Integrations</h1>
                <p class="text-slate-400">{{ integrations|length }} registered integration{{ integrations|length != 1 ? 's' : '' }}</p>
            </div>

            {% if unregisteredTypes is not empty %}
            <div class="mb-8 rounded-2xl border border-amber-800 bg-amber-950 bg-opacity-40 px-6 py-5">
                <h2 class="text-sm font-semibold text-amber-300 mb-2">Unregistered account types</h2>
                <p class="text-sm text-amber-200/80 mb-3">These types appear in tools or server config but have no <code class="font-mono text-xs">*Integration</code> class yet.</p>
                <div class="flex flex-wrap gap-2">
                    {% for type in unregisteredTypes %}
                    <span class="font-mono text-xs font-semibold text-amber-200 bg-amber-900/50 px-3 py-1.5 rounded-lg">{{ type }}</span>
                    {% endfor %}
                </div>
            </div>
            {% endif %}

            {% if integrations is not empty %}
            <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 mb-10">
                {% for item in integrations %}
                <a href="{{ path('admin_integration_detail', {type: item.type}) }}" class="group bg-slate-900 border border-slate-800 hover:border-cyan-800 rounded-2xl p-6 transition-all duration-300 block">
                    <div class="flex items-start justify-between mb-3">
                        <h2 class="text-lg font-bold text-white group-hover:text-cyan-300 transition-colors">{{ item.label }}</h2>
                        <span class="font-mono text-xs text-slate-500 bg-slate-800 px-2 py-1 rounded">{{ item.type }}</span>
                    </div>
                    <p class="text-sm text-slate-400 mb-5 line-clamp-2">{{ item.description }}</p>
                    <div class="flex flex-wrap gap-4 text-xs text-slate-400 font-mono">
                        <span>{{ item.toolCount }} tool{{ item.toolCount != 1 ? 's' : '' }}</span>
                        <span>{{ item.accountCount }} account{{ item.accountCount != 1 ? 's' : '' }}</span>
                        <span>{{ item.serverCount }} server{{ item.serverCount != 1 ? 's' : '' }}</span>
                    </div>
                </a>
                {% endfor %}
            </div>
            {% else %}
            <div class="mb-10 rounded-2xl border border-slate-800 bg-slate-900 px-6 py-8 text-slate-400 text-sm">
                No integrations registered yet. Migrate modules under <code class="font-mono text-cyan-300">src/Integrations/</code> to populate this list.
            </div>
            {% endif %}

            <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6">
                <h2 class="text-lg font-bold text-white mb-1">Utility tools</h2>
                <p class="text-sm text-slate-400 mb-5">Utility tools — available on every server</p>
                {% if utilityTools is not empty %}
                <ul class="divide-y divide-slate-800">
                    {% for tool in utilityTools %}
                    <li class="py-3 flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-4">
                        <code class="text-sm font-mono text-cyan-300 shrink-0">{{ tool.name }}</code>
                        <span class="text-sm text-slate-400">{{ tool.description }}</span>
                    </li>
                    {% endfor %}
                </ul>
                {% else %}
                <p class="text-sm text-slate-500">No utility tools registered.</p>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %}
