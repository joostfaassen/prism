{% extends 'admin/server_base.html.twig' %}

{% block title %}{{ server.label }} — Integrations{% endblock %}

{% block server_page_header %}
            <div class="mb-8">
                <h1 class="text-3xl font-bold text-white mb-2">Integrations</h1>
                <p class="text-slate-400">
                    Capability packs for this server.
                    {{ activeCount }} with profiles &middot; {{ unusedCount }} unused &middot; {{ totalCount }} registered
                </p>
            </div>
{% endblock %}

{% block server_main %}
            <div class="flex flex-wrap gap-2 mb-8">
                <a href="{{ path('admin_server_integrations', {serverName: server.name, filter: 'all'}) }}"
                   class="px-3.5 py-2 rounded-xl text-sm font-medium border transition-colors {% if filter == 'all' %}border-cyan-700 bg-cyan-950/40 text-cyan-200{% else %}border-slate-800 bg-slate-900 text-slate-400 hover:border-slate-700{% endif %}">
                    All <span class="font-mono text-xs opacity-70">{{ totalCount }}</span>
                </a>
                <a href="{{ path('admin_server_integrations', {serverName: server.name, filter: 'active'}) }}"
                   class="px-3.5 py-2 rounded-xl text-sm font-medium border transition-colors {% if filter == 'active' %}border-emerald-700 bg-emerald-950/40 text-emerald-200{% else %}border-slate-800 bg-slate-900 text-slate-400 hover:border-slate-700{% endif %}">
                    With profiles <span class="font-mono text-xs opacity-70">{{ activeCount }}</span>
                </a>
                <a href="{{ path('admin_server_integrations', {serverName: server.name, filter: 'unused'}) }}"
                   class="px-3.5 py-2 rounded-xl text-sm font-medium border transition-colors {% if filter == 'unused' %}border-slate-600 bg-slate-800/60 text-slate-200{% else %}border-slate-800 bg-slate-900 text-slate-400 hover:border-slate-700{% endif %}">
                    Unused here <span class="font-mono text-xs opacity-70">{{ unusedCount }}</span>
                </a>
            </div>

            {% if integrations is not empty %}
            <div class="grid gap-4 sm:grid-cols-2 mb-10">
                {% for item in integrations %}
                <a href="{{ path('admin_server_integration_detail', {serverName: server.name, type: item.type}) }}"
                   class="group bg-slate-900 border rounded-2xl p-6 transition-all duration-300 block
                          {% if item.active %}border-emerald-900/40 hover:border-emerald-700{% else %}border-slate-800/70 hover:border-slate-700 opacity-80 hover:opacity-100{% endif %}">
                    <div class="flex items-start justify-between gap-3 mb-3">
                        <div class="min-w-0">
                            <h2 class="text-lg font-bold text-white group-hover:text-cyan-300 transition-colors truncate">{{ item.label }}</h2>
                            <span class="font-mono text-xs text-slate-500">{{ item.type }}</span>
                        </div>
                        {% if item.active %}
                        <span class="shrink-0 inline-flex items-center gap-1.5 text-[11px] font-mono font-semibold text-emerald-300 bg-emerald-950/80 border border-emerald-900/60 px-2.5 py-1 rounded-lg">
                            <span class="w-1.5 h-1.5 bg-emerald-400 rounded-full"></span>
                            {{ item.profileCount }} profile{{ item.profileCount != 1 ? 's' : '' }}
                        </span>
                        {% else %}
                        <span class="shrink-0 text-[11px] font-mono text-slate-500 bg-slate-800/80 px-2.5 py-1 rounded-lg">unused</span>
                        {% endif %}
                    </div>
                    <p class="text-sm text-slate-400 mb-4 line-clamp-2">{{ item.description }}</p>
                    <div class="text-xs font-mono text-slate-500">{{ item.toolCount }} MCP tool{{ item.toolCount != 1 ? 's' : '' }}</div>
                </a>
                {% endfor %}
            </div>
            {% else %}
            <div class="mb-10 rounded-2xl border border-slate-800 bg-slate-900 px-6 py-10 text-center text-slate-400 text-sm">
                {% if filter == 'active' %}
                    No integrations have profiles on this server yet.
                    <a href="{{ path('admin_server_tab', {serverName: server.name, tab: 'profiles'}) }}" class="text-cyan-400 hover:text-cyan-300">Add profiles</a>.
                {% elseif filter == 'unused' %}
                    Every registered integration has at least one profile on this server.
                {% else %}
                    No integrations registered.
                {% endif %}
            </div>
            {% endif %}

            <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6">
                <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-2 mb-5">
                    <div>
                        <h2 class="text-lg font-bold text-white">Utility tools</h2>
                        <p class="text-sm text-slate-400">Always available on this server (no profile type)</p>
                    </div>
                    <span class="text-xs font-mono text-slate-500">{{ utilityTools|length }} tools</span>
                </div>
                {% if utilityTools is not empty %}
                <ul class="divide-y divide-slate-800">
                    {% for tool in utilityTools %}
                    <li class="py-3 flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-4">
                        <code class="text-sm font-mono text-cyan-300 shrink-0">{{ tool.name }}</code>
                        <span class="text-sm text-slate-400">{{ tool.description }}</span>
                    </li>
                    {% endfor %}
                </ul>
                {% else %}
                <p class="text-sm text-slate-500">No utility tools registered.</p>
                {% endif %}
            </div>
{% endblock %}
