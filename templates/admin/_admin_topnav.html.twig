{# Expects: activeNav = 'servers' | 'integrations' | null; optional crumb (string) #}
<nav class="border-b border-slate-800 bg-slate-900/40">
    <div class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between gap-4">
        <div class="flex items-center gap-4 min-w-0">
            <a href="{{ path('admin_dashboard') }}" class="flex items-center gap-3 shrink-0 group">
                <div class="w-9 h-9 rounded-lg bg-gradient-to-br from-cyan-400 to-blue-500 flex items-center justify-center shadow-lg">
                    <svg class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M13.19 8.688a4.5 4.5 0 0 1 1.242 7.244l-4.5 4.5a4.5 4.5 0 0 1-6.364-6.364l1.757-1.757m13.35-.622 1.757-1.757a4.5 4.5 0 0 0-6.364-6.364l-4.5 4.5a4.5 4.5 0 0 0 1.242 7.244" />
                    </svg>
                </div>
                <span class="text-lg font-bold bg-gradient-to-r from-cyan-300 to-blue-400 bg-clip-text text-transparent group-hover:from-cyan-200 group-hover:to-blue-300 transition-colors">Prism</span>
            </a>

            <div class="hidden sm:flex items-center gap-1 rounded-xl bg-slate-950/50 border border-slate-800 p-1">
                <a href="{{ path('admin_dashboard') }}"
                   class="px-3.5 py-1.5 rounded-lg text-sm font-medium transition-colors {% if activeNav == 'servers' %}bg-slate-800 text-cyan-200{% else %}text-slate-400 hover:text-slate-200{% endif %}">
                    Servers
                </a>
                <a href="{{ path('admin_integrations') }}"
                   class="px-3.5 py-1.5 rounded-lg text-sm font-medium transition-colors {% if activeNav == 'integrations' %}bg-slate-800 text-cyan-200{% else %}text-slate-400 hover:text-slate-200{% endif %}">
                    Integrations
                </a>
            </div>

            {% if crumb is defined and crumb %}
            <div class="hidden md:flex items-center gap-2 min-w-0 text-sm text-slate-500">
                <svg class="w-3.5 h-3.5 shrink-0 text-slate-600" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" /></svg>
                <span class="truncate text-slate-300 font-medium">{{ crumb }}</span>
            </div>
            {% endif %}
        </div>

        <div class="flex items-center gap-3 sm:gap-4 shrink-0">
            <div class="flex sm:hidden items-center gap-1">
                <a href="{{ path('admin_dashboard') }}" class="text-xs font-medium px-2 py-1 rounded {% if activeNav == 'servers' %}text-cyan-300{% else %}text-slate-500{% endif %}">Servers</a>
                <a href="{{ path('admin_integrations') }}" class="text-xs font-medium px-2 py-1 rounded {% if activeNav == 'integrations' %}text-cyan-300{% else %}text-slate-500{% endif %}">Integrations</a>
            </div>
            <span class="text-sm text-slate-400 hidden lg:inline font-mono">{{ app.user.userIdentifier }}</span>
            <a href="{{ path('app_logout') }}" class="text-sm text-slate-400 hover:text-cyan-300 transition-colors font-medium">Sign Out</a>
        </div>
    </div>
</nav>
