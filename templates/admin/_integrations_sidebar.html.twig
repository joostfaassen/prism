{# Expects: navIntegrations (list), filter, activeType (null|string) #}
<nav class="lg:sticky lg:top-10 space-y-1 max-w-full" aria-label="Integrations">
    <p class="text-[10px] font-semibold uppercase tracking-widest text-slate-600 px-3 mb-3 hidden lg:block">Integrations</p>

    <a href="{{ path('admin_integrations', {filter: 'all'}) }}"
       class="flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-medium transition-all duration-200 border
              {% if activeType is null and filter == 'all' %}border-cyan-800/80 bg-cyan-950/50 text-cyan-200 shadow-sm{% else %}border-transparent text-slate-400 hover:text-slate-200 hover:bg-slate-800/60{% endif %}">
        <span class="flex-shrink-0 w-8 h-8 rounded-lg flex items-center justify-center {% if activeType is null and filter == 'all' %}bg-cyan-900/80 text-cyan-300{% else %}bg-slate-800 text-slate-500{% endif %}">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 0 1 6 3.75h2.25A2.25 2.25 0 0 1 10.5 6v2.25a2.25 2.25 0 0 1-2.25 2.25H6a2.25 2.25 0 0 1-2.25-2.25V6ZM3.75 15.75A2.25 2.25 0 0 1 6 13.5h2.25a2.25 2.25 0 0 1 2.25 2.25V18a2.25 2.25 0 0 1-2.25 2.25H6A2.25 2.25 0 0 1 3.75 18v-2.25ZM13.5 6a2.25 2.25 0 0 1 2.25-2.25H18A2.25 2.25 0 0 1 20.25 6v2.25A2.25 2.25 0 0 1 18 10.5h-2.25a2.25 2.25 0 0 1-2.25-2.25V6ZM13.5 15.75a2.25 2.25 0 0 1 2.25-2.25H18a2.25 2.25 0 0 1 2.25 2.25V18A2.25 2.25 0 0 1 18 20.25h-2.25A2.25 2.25 0 0 1 13.5 18v-2.25Z" /></svg>
        </span>
        <span class="flex-1 min-w-0">Overview</span>
    </a>

    <div class="flex gap-1 px-1 py-2">
        <a href="{{ path('admin_integrations', {filter: 'active'}) }}"
           class="flex-1 text-center text-[10px] font-mono px-2 py-1.5 rounded-lg border transition-colors {% if activeType is null and filter == 'active' %}border-emerald-800 bg-emerald-950/50 text-emerald-200{% else %}border-slate-800 text-slate-500 hover:text-slate-300{% endif %}">Active</a>
        <a href="{{ path('admin_integrations', {filter: 'unused'}) }}"
           class="flex-1 text-center text-[10px] font-mono px-2 py-1.5 rounded-lg border transition-colors {% if activeType is null and filter == 'unused' %}border-slate-600 bg-slate-800/60 text-slate-200{% else %}border-slate-800 text-slate-500 hover:text-slate-300{% endif %}">Unused</a>
    </div>

    <p class="text-[10px] font-semibold uppercase tracking-widest text-slate-600 px-3 pt-3 mb-2 hidden lg:block">All packs</p>
    <div class="max-h-[60vh] overflow-y-auto space-y-0.5 pr-1">
        {% for item in navIntegrations %}
        <a href="{{ path('admin_integration_detail', {type: item.type}) }}"
           class="flex items-center gap-2.5 rounded-xl px-3 py-2 text-sm font-medium transition-all duration-200 border
                  {% if activeType == item.type %}border-cyan-800/80 bg-cyan-950/50 text-cyan-200 shadow-sm{% else %}border-transparent text-slate-400 hover:text-slate-200 hover:bg-slate-800/60{% endif %}"
           title="{{ item.label }}">
            <span class="w-1.5 h-1.5 rounded-full shrink-0 {% if item.active %}bg-emerald-400{% else %}bg-slate-600{% endif %}"></span>
            <span class="flex-1 min-w-0 truncate">{{ item.label }}</span>
            {% if item.active %}
            <span class="text-[10px] font-mono tabular-nums text-slate-500">{{ item.accountCount }}</span>
            {% endif %}
        </a>
        {% endfor %}
    </div>
</nav>
